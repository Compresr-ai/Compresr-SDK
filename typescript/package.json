{
  "name": "@compresr/sdk",
  "version": "1.7.1",
  "description": "TypeScript SDK for Compresr - Intelligent context compression to reduce LLM API costs by 30-70%",
  "author": "Compresr Team <founders@compresr.ai>",
  "license": "Apache-2.0",
  "homepage": "https://compresr.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Compresr-ai/Compresr-SDK.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Compresr-ai/Compresr-SDK/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "llm",
    "compression",
    "ai",
    "openai",
    "gpt",
    "tokens",
    "cost-optimization",
    "context-compression",
    "rag",
    "anthropic",
    "claude"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./integrations/langchain": {
      "import": {
        "types": "./dist/esm/integrations/langchain/index.d.ts",
        "default": "./dist/esm/integrations/langchain/index.js"
      },
      "require": {
        "types": "./dist/cjs/integrations/langchain/index.d.ts",
        "default": "./dist/cjs/integrations/langchain/index.js"
      }
    },
    "./integrations/langgraph": {
      "import": {
        "types": "./dist/esm/integrations/langgraph/index.d.ts",
        "default": "./dist/esm/integrations/langgraph/index.js"
      },
      "require": {
        "types": "./dist/cjs/integrations/langgraph/index.d.ts",
        "default": "./dist/cjs/integrations/langgraph/index.js"
      }
    },
    "./integrations/llamaindex": {
      "import": {
        "types": "./dist/esm/integrations/llamaindex/index.d.ts",
        "default": "./dist/esm/integrations/llamaindex/index.js"
      },
      "require": {
        "types": "./dist/cjs/integrations/llamaindex/index.d.ts",
        "default": "./dist/cjs/integrations/llamaindex/index.js"
      }
    },
    "./agents": {
      "import": {
        "types": "./dist/esm/agents/index.d.ts",
        "default": "./dist/esm/agents/index.js"
      },
      "require": {
        "types": "./dist/cjs/agents/index.d.ts",
        "default": "./dist/cjs/agents/index.js"
      }
    },
    "./agents/research": {
      "import": {
        "types": "./dist/esm/agents/research/index.d.ts",
        "default": "./dist/esm/agents/research/index.js"
      },
      "require": {
        "types": "./dist/cjs/agents/research/index.d.ts",
        "default": "./dist/cjs/agents/research/index.js"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/esm/auth/index.d.ts",
        "default": "./dist/esm/auth/index.js"
      },
      "require": {
        "types": "./dist/cjs/auth/index.d.ts",
        "default": "./dist/cjs/auth/index.js"
      }
    }
  },
  "peerDependencies": {
    "@langchain/anthropic": ">=1.0.0",
    "@langchain/community": ">=0.3.0",
    "@langchain/core": ">=0.3.0",
    "@langchain/google-genai": ">=0.2.0",
    "@langchain/langgraph": ">=0.2.0",
    "@langchain/openai": ">=1.0.0",
    "@langchain/tavily": ">=0.1.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "langchain": ">=1.0.0",
    "llamaindex": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "@langchain/anthropic": {
      "optional": true
    },
    "@langchain/community": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/google-genai": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@langchain/openai": {
      "optional": true
    },
    "@langchain/tavily": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "langchain": {
      "optional": true
    },
    "llamaindex": {
      "optional": true
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin/**",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:cjs:fixup",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs:fixup": "echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.7",
    "@langchain/tavily": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "langchain": "^1.4.2",
    "llamaindex": "^0.12.1",
    "msw": "^2.2.0",
    "openai": "^6.42.0",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "bin": {
    "compresr-sdk": "./bin/compresr-sdk.cjs"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "fast-uri": "^3.1.4"
  }
}
